{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "MongoDbSettings": {
        "ConnectionString": "${MONGO_CONNECTION_STRING}",
        "DatabaseName": "${MONGO_DB}"
    },
    "JwtSettings": {
        "Issuer": "${JWT_ISSUER}",
        "Audience": "${JWT_AUDIENCE}",
        "SecretKey": "${JWT_SECRET_KEY}"
    }
}